# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual Environments
.venv/
venv/
ENV/
env/

# Node / Frontend Dependencies & Cache
ui/node_modules/
ui/.npm/
ui/.vite/

# Keep pre-built production UI bundle so app runs without needing npm
!ui/dist/

# Edge WebView2 cache and data
WebView2Data/
EBWebView/

# Temporary / Scratch Files
scratch_*.json
scratch/
*.tmp
*.log

# Local Windows Shortcuts (contain local machine absolute paths)
*.lnk

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store

# IDE and Editor configs
.vscode/
.idea/
